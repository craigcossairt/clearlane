{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@contracts/*": ["./contracts/*"],
      "@engine/*": ["./engine/src/*"]
    }
  },
  "include": ["contracts", "engine", "app/src", "tools", "vite.config.ts", "vitest.config.ts"]
}
